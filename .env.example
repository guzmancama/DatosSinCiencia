# Plantilla de la conexion a la base de datos.
#
#   cp .env.example .env
#
# El .env real nunca se sube (esta en .gitignore). Esta plantilla si se sube,
# por eso no lleva ninguna clave real, solo el formato que hay que llenar.

# Conexion a Supabase (Postgres).
# Formato: postgresql+psycopg2://<usuario>:<clave>@<host>:<puerto>/<base_de_datos>
DATABASE_URL=postgresql+psycopg2://postgres.CAMBIAR:CAMBIAR_CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- De donde sale esa URL ---
# 1. Entra al proyecto en https://supabase.com/dashboard
# 2. Settings -> Database -> Connection string -> elegi "Connection pooling"
#    (el modo "Transaction", puerto 5432 o 6543 segun el proyecto)
# 3. Supabase te la da en formato "postgresql://..."; nosotros solo le
#    agregamos el "+psycopg2" despues de "postgresql" para que SQLAlchemy
#    sepa con que driver conectarse.
# 4. Copiala completa en DATABASE_URL de arriba, con tu password real
#    (la que pusiste al crear el proyecto, o la que reseteaste en
#    Settings -> Database -> Reset database password).
#
# Si el proyecto lleva un tiempo sin usarse, Supabase lo pausa solo: entra
# al dashboard y dale "Restore" antes de correr el notebook.
