# Plantilla de configuracion de la base de datos.
#
#   cp .env.example .env
#
# El archivo .env real NUNCA se sube al repositorio (esta excluido en
# .gitignore). Esta plantilla si se sube, y por eso NO lleva una contrasena
# real: lleva un marcador que hay que cambiar.

# Conexion a PostgreSQL.
# Formato: postgresql+psycopg://<usuario>:<clave>@<host>:<puerto>/<base_de_datos>
#
# El driver "psycopg" corresponde a psycopg 3 (el que instala requirements.txt).
# Usa "+psycopg2" unicamente si instalaste psycopg2 en su lugar.
DATABASE_URL=postgresql+psycopg://bodega:CAMBIAR_CLAVE@localhost:5433/siniestralidad

# --- Como levantar la base ---
# El usuario, la contrasena y la base los eliges tu; deben coincidir con los
# de DATABASE_URL. El puerto del host (5433) casi siempre hay que cambiarlo,
# porque el 5432 suele estar ocupado por otro proyecto local.
#
#   docker run -d --name bodega-siniestralidad \
#     -e POSTGRES_USER=bodega \
#     -e POSTGRES_PASSWORD=CAMBIAR_CLAVE \
#     -e POSTGRES_DB=siniestralidad \
#     -p 5433:5432 postgres:17
#
# En DATABASE_URL el host va como "localhost", nunca como el nombre del
# contenedor: el puerto 5433 esta publicado en el host, no dentro de la red de
# Docker.
#
# Para empezar:
#   docker start bodega-siniestralidad
